name: CI/CD Pipeline

# Триггеры запуска: при push в main и при создании Pull Request в main
on:
  push:
    branches: [ "main" ]
  pull_request:
    branches: [ "main" ]

env:
  REGISTRY: ghcr.io
  # Имя образа будет соответствовать вашему репозиторию на GitHub (например, ghcr.io/vikktoriam/islabapp)
  IMAGE_NAME: ${{ github.repository }}

jobs:
  build-and-test:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write

    steps:
      # 1. Клонирование репозитория
      - name: Checkout repository
        uses: actions/checkout@v4

      # 2. Установка .NET SDK
      - name: Setup .NET
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: '8.0.x' # Убедитесь, что версия совпадает с вашим проектом

      # 3. Восстановление зависимостей
      - name: Restore dependencies
        run: dotnet restore

      # 4. Сборка проекта
      - name: Build
        run: dotnet build --no-restore --configuration Release

      # 5. Запуск тестов (Unit-тесты для 19 варианта: Ладья и др.)
      - name: Test
        run: dotnet test --no-build --verbosity normal

      # 6. Авторизация в GitHub Container Registry
      - name: Log in to the Container registry
        uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      # 7. Извлечение метаданных и настройка требуемых тегов (latest и short-sha)
      - name: Extract Docker metadata
        id: meta
        uses: docker/metadata-action@v5
        with:
          images: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}
          tags: |
            # Тег latest
            type=raw,value=latest
            # Тег с коротким SHA коммита (7 символов)
            type=sha,format=short

      # 8. Сборка Docker-образа и отправка (Push) в GHCR
      - name: Build and push Docker image
        uses: docker/build-push-action@v5
        with:
          context: .
          push: true
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
